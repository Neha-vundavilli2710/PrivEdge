APP_NAME=PrivEdge Backend
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite for dev; PostgreSQL URL works too, e.g. postgresql+psycopg2://user:pw@localhost/privedge)
DATABASE_URL=sqlite:///./privedge.db

# --- JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Cloud AI (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Edge AI (Ollama, runs on your machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Router: rule | ml
ROUTER_MODE=rule
ML_MODEL_PATH=app/ml/routing_model.joblib

# --- Encryption key for stored message text (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Seed accounts created on first start (change passwords!)
SEED_ADMIN_EMAIL=admin@privedge.io
SEED_ADMIN_PASSWORD=Admin@12345
SEED_REVIEWER_EMAIL=reviewer@privedge.io
SEED_REVIEWER_PASSWORD=Reviewer@12345

# --- Routing policy thresholds (project-defined, tune freely)
PRIVACY_THRESHOLD=0.70
SENSITIVITY_THRESHOLD=0.70
RISK_THRESHOLD=0.80
COMPLEXITY_THRESHOLD=0.55
LATENCY_THRESHOLD=0.70
HUMAN_THRESHOLD=0.60

# --- Settings-enforcement step
SESSION_IDLE_MINUTES=30
REVIEW_BACKLOG_THRESHOLD=5
